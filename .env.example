# Browser-safe Supabase project settings. The anon key is protected by database RLS policies.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional: PostgreSQL connection string used only by npm run db:migrate.
DATABASE_URL=postgres://postgres:password@localhost:5432/heritage_days
